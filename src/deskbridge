# ---------------------------------------------------------------- autostart

def autostart_enabled(paths: Paths) -> bool:
    try:
        r = run(["systemctl", "--user", "is-enabled", "--quiet", paths.unit], timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0


def autostart_set(paths: Paths, enable: bool, st: dict) -> dict:
    if enable:
        write_unit(paths, st)
    if enable and not autostart_enabled(paths):
        r = run(["systemctl", "--user", "enable", paths.unit], timeout=15)
        if r.returncode != 0:
            return {"enabled": False, "error": (r.stderr or r.stdout).strip()}
    elif not enable and autostart_enabled(paths):
        r = run(["systemctl", "--user", "disable", paths.unit], timeout=15)
        if r.returncode != 0:
            return {"enabled": True, "error": (r.stderr or r.stdout).strip()}
    return {"enabled": autostart_enabled(paths)}


def cmd_autostart(args) -> int:
    paths = Paths(args.profile)
    st = adopt_state(paths, load_state(paths))
    require_configured(paths, st)
    res = autostart_set(paths, args.mode == "on", st) if args.mode != "status" else {"enabled": autostart_enabled(paths)}
    st["autostart"] = res["enabled"]
    save_state(paths, st)
    print(json.dumps(res) if args.json else f"Autostart {'on' if res['enabled'] else 'off'}" + (f": {res['error']}" if res.get("error") else ""))
    return 1 if res.get("error") else 0


# ---------------------------------------------------------------- wizard

def ask(prompt: str, default: str | None, args) -> str:
    if getattr(args, "yes", False) and default is not None:
        return default
    suffix = f" [{default}]" if default else ""
    try:
        val = input(f"{prompt}{suffix}: ").strip()
    except EOFError:
        val = ""
    return val or (default or "")


def cmd_setup(args) -> int:
    paths = Paths(args.profile)
    st = adopt_state(paths, load_state(paths))
    if profile_processes(paths) or (paths.profile == "default" and any(p["name"] == "deskflow" for p in find_engine_processes())):
        die("stop the existing Deskflow instance before changing its configuration", 2)
    adopted = st.get("wizard_done") or paths.engine_conf.is_file()
    results: dict = {}

    # 1. role
    if args.role:
        st["role"] = args.role
    elif st.get("role") and not args.yes:
        st["role"] = ask(f"role (server = machine with keyboard+mouse)", st["role"], args) or st["role"]
    else:
        st["role"] = args.role or (st.get("role") if args.yes else ask("role (server = machine with keyboard+mouse)", "client", args))
    if st["role"] not in ("server", "client"):
        die("role must be 'server' or 'client'", 2)

    # 2. peer
    peer_default = args.peer or st.get("peer")
    if st["role"] == "client":
        if not peer_default:
            found = discover(None, paths.port) if not args.yes else []
            cands = [f["ip"] for f in found]
            if cands and not args.yes:
                print("engines found on this LAN: " + ", ".join(cands))
            peer_default = None
        st["peer"] = ask("server address (IP of the machine with keyboard+mouse)", peer_default, args)
        if not st["peer"]:
            die("client needs a server address", 2)
    else:
        st["peer"] = args.peer or st.get("peer")  # informational only

    # 3. name
    name_default = args.name or st.get("name") or (
        "fedora" if st["role"] == "client" else "windows")
    st["name"] = ask("computer name (must be unique across both machines)", name_default, args)
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}", st["name"]):
        die("computer name must be 1-64 letters, digits, underscores or hyphens", 2)

    # 4. port
    st["port"] = int(args.port if args.port is not None else st.get("port") or paths.port)
    if not 1 <= st["port"] <= 65535:
        die("port must be between 1 and 65535", 2)
    if st.get("peer"):
        try:
            ipaddress.ip_address(st["peer"])
        except ValueError:
            if st["role"] == "server" or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9.-]{0,252}", st["peer"]):
                die("peer must be an IP address (client may use a DNS hostname)", 2)

    # 5. screen placement (server only)
    if st["role"] == "server":
        if args.side:
            side = args.side
        else:
            side = ask("which side is the client monitor on? (left/right/top/bottom)",
                        next(iter((st.get("map") or {}).get(st["name"], {})), "left"), args)
        if side not in SIDES:
            die("side must be left, right, top or bottom", 2)
        client_name = ask("name for the client machine (must match its computer name)",
                           args.peer_name or st.get("client_name") or next(iter((st.get("map") or {}).get(st["name"], {}).values()), "fedora"), args)
        if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,63}", client_name) or client_name == st["name"]:
            die("peer name must be valid and different from this computer name", 2)
        st["client_name"] = client_name
        st["map"] = {st["name"]: {side: client_name}, client_name: {SIDES[side]: st["name"]}}

    # 6. engine choice
    st["engine"] = args.engine or st.get("engine") or "gui"
    paths.role = st["role"]
    if args.quiet_layouts:
        st["quiet_layouts"] = True
    expected = fingerprint_canon(args.trust_fingerprint) if args.trust_fingerprint else None

    # 7. local certificate
    res = ensure_cert(paths)
    results["cert"] = res
    if res.get("error"):
        die(res["error"], 3)
    fp = cert_fingerprint(paths)

    # 8. pairing (client): fetch server fingerprint if reachable
    if expected:
        if st["role"] == "client":
            probe = deep_probe(st["peer"], st["port"], paths.cert)
            if not probe.get("ok") or not secrets.compare_digest(probe.get("fingerprint", ""), expected):
                die("server fingerprint could not be verified against the supplied fingerprint; no trust added", 3)
        results["trust"] = trust_add(paths, expected)
    else:
        results["trust"] = {"added": False, "note": "Compare full fingerprints on BOTH PCs in the native pairing dialogs. --yes never accepts a new peer."}

    # 9. write configs
    backups = write_engine_conf(paths, st)
    if st["role"] == "server":
        write_server_map(paths, st)
    results["backups"] = backups

    # 10. firewall (server role, Linux)
    if st["role"] == "server":
        if st.get("peer"):
            res = firewall_apply(paths, st["peer"], st["port"])
            results["firewall"] = res
            st["firewall_scoped"] = res.get("applied", False)
        else:
            results["firewall"] = {"applied": False, "reason": "no peer address given"}
            st["firewall_scoped"] = False
    else:
        results["firewall"] = {"applied": False, "reason": "client role: no inbound rule needed"}

    # 11. autostart
    if args.autostart is not None:
        want = args.autostart == "on"
    else:
        want = ask("start at login?", "yes" if autostart_enabled(paths) else "no", args) in ("y", "yes", "true")
    if want:
        results["autostart"] = autostart_set(paths, True, st)
    else:
        results["autostart"] = autostart_set(paths, False, st)
    st["autostart"] = autostart_enabled(paths)

    st["wizard_done"] = True
    if not st.get("created"):
        st["created"] = now_iso()
    save_state(paths, st)
    results["state"] = str(paths.state_file)
    install_launchers(paths)
    results["config"] = str(paths.engine_conf)
    results["map"] = str(paths.server_map) if st["role"] == "server" else None
    results["fingerprint"] = f"v2:sha256:{fp}" if fp else None

    # 12. validation + optional start
    errs = validate_conf(paths, st)
    results["config_errors"] = errs
    if args.start_now:
        args2 = argparse.Namespace(profile=args.profile, json=args.json)
        results["start"] = "see deskbridge start" if errs else "run: deskbridge start"
        if not errs:
            res = start_engine(paths, st)
            results["start"] = res
    if args.json:
        print(json.dumps(results, indent=2, sort_keys=True))
    else:
        print(f"setup complete for profile '{paths.profile}'")
        print(f"  role/name  : {st['role']} / {st['name']}")
        if st["peer"]:
            print(f"  peer       : {st['peer']}:{st['port']}")
        if st["role"] == "server":
            edge = next(iter((st.get("map") or {}).get(st["name"], {})), "?")
            print(f"  screen map : client is on the {edge} edge")
            fw = results.get("firewall", {})
            print(f"  firewall   : {'peer allow added; review other firewall policy' if fw.get('applied') else fw.get('reason', 'n/a')}")
        print(f"  certificate: {'created' if results['cert'].get('created') else 'kept existing'} {results['cert'].get('path', '')}")
        if fp:
            print(f"  fingerprint: v2:sha256:{fp}")
            print("  -> at the other machine: deskbridge fingerprint (compare these values)")
        tr = results.get("trust", {})
        if tr.get("added"):
            print(f"  trust      : server fingerprint stored ({tr['fingerprint'][:24]}\u2026)")
        elif tr.get("note") and not adopted:
            print(f"  trust      : {tr['note']}")
        print(f"  autostart  : {'enabled' if st['autostart'] else 'off'}")
        if errs:
            print("  config     : INVALID -> " + "; ".join(errs), file=sys.stderr)
        if st["role"] == "client":
            lay = local_layouts()
            if lay:
                print(f"  layouts    : local = {', '.join(lay)} (install the same on the server machine)")
        print("next: deskbridge start   (then move the cursor to the shared edge)")
    return 0 if not errs and not results.get("autostart", {}).get("error") and not (args.start_now and not results.get("start", {}).get("started", False)) else 6




