def collect_status(paths: Paths, st: dict) -> dict:
    port = st.get("port") or paths.port
    procs = profile_processes(paths)
    tcp = []
    if shutil.which("ss"):
        r = run(["ss", "-tn", "state", "established", "state", "syn-sent", "state", "syn-recv"], timeout=10)
        for line in r.stdout.splitlines()[1:]:
            parts = line.split()
            if len(parts) >= 5 and (parts[4].endswith(f":{port}") or parts[3].endswith(f":{port}")):
                tcp.append({"local": parts[4], "peer": parts[5] if len(parts) > 5 else parts[3], "state": parts[1]})
    bins = engine_binaries(paths)
    ok, note = engine_ok(paths, st)
    return {
        "profile": paths.profile,
        "role": st.get("role"),
        "name": st.get("name"),
        "peer": st.get("peer"),
        "port": port,
        "engine_kind": st.get("engine") or "gui",
        "engine_installed": bool(bins.get(st.get("engine") or "gui") or bins.get("core")),
        "engine_version": engine_version(bins.get("core")),
        "engine_ok": ok,
        "engine_note": note,
        "config_present": paths.engine_conf.is_file(),
        "config_errors": validate_conf(paths, st) if paths.engine_conf.is_file() else ["engine config missing"],
        "processes": [{"pid": p["pid"], "name": p["name"], "cmdline": p["cmdline"]} for p in procs],
        "unit": {"name": paths.unit, "active": unit_active(paths), "main_pid": unit_main_pid(paths)},
        "tcp": tcp,
        "tls": {
            "cert": str(paths.cert) if paths.cert.is_file() else None,
            "fingerprint": cert_fingerprint(paths),
            "trusted_peers": trust_lines(paths),
        },
        "firewall": {"state": firewall_state(), "scoped": bool(st.get("firewall_scoped"))},
        "autostart": bool(st.get("autostart")),
        "log_tail": log_tail(paths),
    }


def adopt_state(paths: Paths, st: dict) -> dict:
    """Fill role/name/peer from an existing engine config when no state exists."""
    if st.get("role") or not paths.engine_conf.is_file():
        return st
    flat = read_engine_conf(paths)
    mode = flat.get("core.coreMode", "")
    if mode not in ("1", "2"):
        return st
    return dict(st, role="client" if mode == "1" else "server",
                name=st.get("name") or flat.get("core.computerName", ""),
                peer=st.get("peer") or flat.get("client.remoteHost", ""))


def cmd_status(args) -> int:
    paths = Paths(args.profile)
    st = adopt_state(paths, load_state(paths))
    out = collect_status(paths, st)
    if args.json:
        print(json.dumps(out, indent=2, sort_keys=True))
        return 0
    print(f"DeskBridge profile '{paths.profile}'  (app {app_version()})")
    role = st.get("role") or "?"
    print(f"  role/name : {role} / {st.get('name') or '?'}")
    print(f"  peer/port : {st.get('peer') or '-'} : {out['port']}")
    eng = "ok" if out["engine_ok"] else f"NOT OK ({out['engine_note']})"
    print(f"  engine    : v{out['engine_version']} [{eng}]")
    errs = out["config_errors"]
    print(f"  config    : {'valid' if not errs else 'INVALID: ' + '; '.join(errs)}")
    if out["processes"]:
        ps = ", ".join(f"{p['name']}(pid {p['pid']})" for p in out["processes"])
        print(f"  processes : {ps}")
    else:
        print("  processes : none (engine not running)")
    u = out["unit"]
    print(f"  unit      : {u['name']} {'active' if u['active'] else 'inactive'}")
    if out["tcp"]:
        for t in out["tcp"]:
            print(f"  tcp       : {t['local']} <-> {t['peer']} [{t['state']}]")
    else:
        print(f"  tcp       : no connections on port {out['port']}")
    fp = out["tls"]["fingerprint"]
    print(f"  tls       : cert {'present' if out['tls']['cert'] else 'MISSING'}"
          + (f" fp={fp[:16]}\u2026" if fp else ""))
    tp = out["tls"]["trusted_peers"]
    print(f"  trusted   : {len(tp)} peer fingerprint(s)")
    print(f"  firewall  : {out['firewall']['state']}" + (" (scoped to peer)" if out["firewall"]["scoped"] else ""))
    if out["log_tail"]:
        print("  log (last lines):")
        for ln in out["log_tail"]:
            print(f"    {ln}")
    return 0


def require_configured(paths: Paths, st: dict) -> None:
