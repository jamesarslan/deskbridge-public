def display_protocol() -> str:
    x = os.environ.get("XDG_SESSION_TYPE", "")
    if x:
        return x
    if os.environ.get("WAYLAND_DISPLAY"):
        return "wayland"
    if os.environ.get("DISPLAY"):
        return "x11"
    return "none"


def _diagnose_checks(paths: Paths, st: dict) -> list[dict]:
    """Check list shared by cmd_diagnose and the web status endpoint."""
    port = st.get("port") or paths.port
    checks: list[dict] = []

    def add(ok: bool, warn: bool, what: str, detail: str = "", fix: str = ""):
        checks.append({"status": "pass" if ok else ("warn" if warn else "fail"),
                       "what": what, "detail": detail, "fix": fix})

    ok, note = engine_ok(paths, st)
    add(ok, False, f"engine installed (>= {ENGINE_MIN})", note or "ok", "dnf install deskflow")
    if not st.get("role"):
        add(False, True, "configured", "no state found", "deskbridge setup")
        return checks
    errs = validate_conf(paths, st) if paths.engine_conf.is_file() else ["engine config missing"]
    add(not errs, False, "engine config valid", "; ".join(errs), "deskbridge repair")
    fp = cert_fingerprint(paths)
    add(bool(fp), False, "local TLS certificate", fp or "missing", "deskbridge repair")
    procs = profile_processes(paths)
    add(bool(procs), not procs, "engine running",
        ", ".join(p["name"] for p in procs), "deskbridge start")
    if st["role"] == "client" and st.get("peer"):
        open_ = tcp_open(st["peer"], port, 2.0)
        add(open_, False, f"server reachable at {st['peer']}:{port}",
            "tcp open" if open_ else "tcp closed/filtered", "deskbridge start on the server machine")
    return checks


def cmd_diagnose(args) -> int:
    paths = Paths(args.profile)
    st = adopt_state(paths, load_state(paths))
    port = st.get("port") or paths.port
    checks: list[dict] = list(_diagnose_checks(paths, st))

    if st.get("role"):
        if st["role"] == "client":
            peer = st.get("peer") or ""
            tls = trust_lines(paths)
            checks.append({"status": "pass" if tls else "warn", "what": "server fingerprint trusted",
                           "detail": f"{len(tls)} entry/entries",
                           "fix": f"deskbridge discover --deep --peer {peer} (compare full fingerprint at server before trust add)" if not tls else ""})
            lay = local_layouts()
            checks.append({"status": "pass" if lay else "warn", "what": "input layouts detected",
                           "detail": ", ".join(lay),
                           "fix": "install matching layouts on the server machine" if not lay else ""})
        else:
            checks.append({"status": "pass" if paths.server_map.is_file() else "fail",
                           "what": "screen map present", "detail": str(paths.server_map),
                           "fix": "" if paths.server_map.is_file() else "deskbridge repair"})
            if st.get("peer"):
                fw = firewall_state()
                scoped = False
                if fw == "running":
                    r = run([*sudo_prefix(), "firewall-cmd",
                             f"--query-rich-rule={rich_rule(st['peer'], port)}"], timeout=15)
                    scoped = r.returncode == 0
                checks.append({"status": "warn",
                               "what": "firewall peer allow rule",
                               "detail": "peer allow present; other rules/policies may allow more" if scoped else "peer allow rule not verified; review firewall policy",
                               "fix": "review active zone and other services; deskbridge repair adds the peer allow"})
        procs = profile_processes(paths)
        if procs and st["role"] == "client":
            r = run(["ss", "-tn", "state", "established"], timeout=10)
            est = any(f":{port}" in ln for ln in r.stdout.splitlines())
            checks.append({"status": "pass" if est else "warn", "what": "tcp connection established",
                           "detail": "", "fix": "wait a moment, then check the log"})
        checks.append({"status": "warn" if display_protocol() == "none" else "pass", "what": "invoking display session", "detail": display_protocol(),
                       "fix": "run inside the desktop session" if display_protocol() == "none" else ""})
        tail = log_tail(paths, 3)
        checks.append({"status": "pass", "what": "recent log",
                       "detail": " | ".join(t[-70:] for t in tail) if tail else "(no log yet)", "fix": ""})

    if args.json:
        print(json.dumps({"profile": paths.profile, "checks": checks}, indent=2, sort_keys=True))
        return 1 if any(c["status"] == "fail" for c in checks) else 0
    for c in checks:
        mark = {"pass": "PASS", "warn": "WARN", "fail": "FAIL"}[c["status"]]
        line = f"  {mark}  {c['what']}"
        if c["detail"]:
            line += f"  ({c['detail']})"
        print(line)
        if c["fix"] and c["status"] != "pass":
            print(f"        fix: {c['fix']}")
    fails = [c for c in checks if c["status"] == "fail"]
    return 1 if fails else 0


