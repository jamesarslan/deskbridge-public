        out["config"] = {"rewritten": True, "backups": write_engine_conf(paths, st)}
        if st["role"] == "server":
            write_server_map(paths, st)
    else:
        out["config"] = {"rewritten": False}
    res = ensure_cert(paths)
    out["cert"] = res
    if st["role"] == "server" and st.get("peer"):
        out["firewall"] = firewall_apply(paths, st["peer"], st["port"] or paths.port)
    save_state(paths, st)
    out["config_errors"] = validate_conf(paths, st)
    if args.json:
        print(json.dumps(out, indent=2, sort_keys=True))
    else:
        print(f"repair: config {'rewritten' if out['config']['rewritten'] else 'ok'}"
              f", cert {'created' if res.get('created') else 'ok'}")
        if out["firewall"]:
            print(f"repair: firewall {out['firewall'].get('applied') or out['firewall'].get('reason')}")
        if out["config_errors"]:
            print("still invalid: " + "; ".join(out["config_errors"]), file=sys.stderr)
    return 0 if not out["config_errors"] else 6


# ---------------------------------------------------------------- uninstall

LEGACY_DESKTOP_NAMES = ("deskbridge-start.desktop", "deskbridge-stop.desktop")


def cmd_uninstall(args) -> int:
    paths = Paths(args.profile)
    out: dict = {"profile": paths.profile}
    out["stop"] = stop_engine(paths)
    if autostart_enabled(paths):
        run(["systemctl", "--user", "disable", paths.unit], timeout=15)
    for legacy in LEGACY_DESKTOP_NAMES:
        for d in (paths.home / ".config/autostart", paths.home / ".local/share/applications"):
            p = d / legacy
            if p.is_file():
                p.unlink()
                out.setdefault("legacy_removed", []).append(str(p))
    if paths.engine_conf.is_file():
        bak = paths.engine_conf.with_name(paths.engine_conf.name + f".uninstalled.{int(time.time())}")
        paths.engine_conf.replace(bak)
        out["config_backup"] = str(bak)
    if paths.server_map.is_file():
        paths.server_map.unlink()
        out["map_removed"] = True
    st = load_state(paths)
    if st.get("role") == "server" and st.get("peer"):
        out["firewall"] = firewall_remove(paths, st["peer"], st.get("port") or paths.port)
    removed = []
    for p in (paths.state_file, paths.server_map, paths.log_file):
        if p.is_file():
            p.unlink()
            removed.append(str(p))
    # Non-default profiles own their whole tree: sweep it, keeping TLS and
    # the .uninstalled config backup. Default profile shares ~/.config/Deskflow
    # with the engine, so only known product files go.
    if paths.xdg is not None:
        for root, dirs, files in os.walk(paths.app_home, topdown=False):
            rp = pathlib.Path(root)
            for f in files:
                fp = rp / f
                if fp.is_relative_to(paths.tls_dir) or fp.name.startswith(paths.engine_conf.name + ".uninstalled"):
                    continue
                try:
                    fp.unlink()
                    removed.append(str(fp))
                except OSError:
                    pass
            try:
                if not any(rp.iterdir()):
                    rp.rmdir()
            except OSError:
                pass
    out["removed"] = removed
    out["state_removed"] = True
    if args.json:
        print(json.dumps(out, indent=2, sort_keys=True))
    else:
        print("uninstalled profile " + paths.profile)
        if out.get("config_backup"):
            print(f"  engine config backed up to: {out['config_backup']}")
        if out.get("legacy_removed"):
            for p in out["legacy_removed"]:
                print(f"  removed legacy: {p}")
        print("  engine itself left in place (rm: sudo dnf remove deskflow)  " )
        print("  TLS certs and trust db remain under the engine home; delete manually if wanted")
    return 0


