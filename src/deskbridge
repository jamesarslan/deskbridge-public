APP = "DeskBridge"
VERSION_FALLBACK = "0.2.0"
ENGINE_MIN = "1.27.0"
DEFAULT_PORT = 24800
WEB_DEFAULT_PORT = 8472
CERT_DAYS = 365
CERT_KEY_SIZE = 2048
CERT_SUBJECT = "/CN=Deskflow"
SIDES = {"left": "right", "right": "left", "top": "bottom", "bottom": "top"}
ENGINE_BINARIES = {"gui": "deskflow", "core": "deskflow-core"}
LEGACY_PROC_NAMES = ("deskflow", "deskflow-core", "deskflow-client", "deskflow-server")
ENGINE_HOME_REL = pathlib.PurePosixPath("Deskflow")
APP_HOME_REL = pathlib.PurePosixPath("DeskBridge")
STATE_REL = pathlib.PurePosixPath(".local/state/deskbridge")
FINGERPRINT_RE = re.compile(r"^(v2:sha256:)?([0-9a-fA-F]{64})$")
HEX_RE = re.compile(r"^[0-9a-fA-F]{8,64}$")


def app_version() -> str:
    here = pathlib.Path(__file__).resolve().parent
    for rel in (pathlib.PurePath("..") / "VERSION", pathlib.PurePath("VERSION")):
        p = (here / rel).resolve()
        if p.is_file():
            text = p.read_text().strip()
            if not text:
                continue
            # VERSION may be JSON ({ "version": "..." }) or a plain line.
            try:
                data = json.loads(text)
                if isinstance(data, dict) and data.get("version"):
                    return str(data["version"]).strip()
            except json.JSONDecodeError:
                pass
            m = re.search(r"(\d+(?:\.\d+)*[A-Za-z0-9.\-+]*)", text)
            if m:
                return m.group(1)
    return VERSION_FALLBACK


class Paths:
    """All file paths for one profile, isolated per profile."""

    def __init__(self, profile: str, home: pathlib.Path | None = None):
        self.profile = profile
        self.home = (home or pathlib.Path(os.path.expanduser("~"))).resolve()
        self.config_root = self.home / ".config"
        self.app_home = self.config_root / APP_HOME_REL / profile
        self.state_file = self.app_home / "deskbridge.json"
        self.state_dir = self.home / STATE_REL.parent / "deskbridge"
        self.log_file = self.state_dir / f"{profile}.log"
        self.unit = f"deskbridge-{profile}"
        if profile == "default":
            # Standard engine path: ~/.config/Deskflow (no XDG override).
            self.xdg: pathlib.Path | None = None
            self.engine_home = self.config_root / ENGINE_HOME_REL
        else:
            # Isolated: the engine (GUI) reads its home from XDG_CONFIG_HOME.
            self.xdg = self.app_home / "xdg"
            self.engine_home = self.xdg / ENGINE_HOME_REL
        self.engine_conf = self.engine_home / "Deskflow.conf"
        self.tls_dir = self.engine_home / "tls"
        self.cert = self.tls_dir / "deskflow.pem"
        self.trust_db = self.tls_dir / "trusted-servers"
        self.server_map = self.engine_home / "server.config"
        self.port = DEFAULT_PORT if profile == "default" else (
            DEFAULT_PORT + 1 + zlib.crc32(profile.encode()) % 100
        )


def die(msg: str, code: int = 1, json_out: dict | None = None):
    if json_out is not None:
        print(json.dumps(json_out, indent=2, sort_keys=True))
    print(f"{APP}: {msg}", file=sys.stderr)
    sys.exit(code)


def run(cmd: list[str], timeout: float = 15.0, **kw) -> subprocess.CompletedProcess:
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, **kw)


def sudo_prefix() -> list[str]:
    if os.geteuid() == 0:
        return []
    if shutil.which("sudo"):
        return ["sudo"]
    return []


def now_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def sha256_hex(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def parse_version(text: str):
    m = re.search(r"(\d+)\.(\d+)\.(\d+)", text)
    return tuple(int(x) for x in m.groups()) if m else (0, 0, 0)


def atomic_write(path: pathlib.Path, text: str, mode: int = 0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".tmp")
    tmp.write_text(text)
    os.chmod(tmp, mode)
    os.replace(tmp, path)


def default_state(profile: str) -> dict:
    return {
        "version": 1,
        "profile": profile,
        "role": None,
        "name": None,
        "peer": None,
        "port": None,
        "engine": "gui",
        "autostart": False,
        "firewall_scoped": False,
        "map": {},
        "wizard_done": False,
        "created": None,
        "updated": None,
    }


def load_state(paths: Paths) -> dict:
    st = default_state(paths.profile)
    if paths.state_file.is_file():
        try:
            data = json.loads(paths.state_file.read_text())
            st.update(data)
        except (json.JSONDecodeError, OSError):
            pass
    return st


def save_state(paths: Paths, st: dict):
    st["updated"] = now_iso()
    atomic_write(paths.state_file, json.dumps(st, indent=2, sort_keys=True) + "\n")


# ---------------------------------------------------------------- config

def read_engine_conf(paths: Paths) -> dict:
    """Parse the engine INI into a flat section-key dict. Tolerant."""
    cp = configparser.ConfigParser(interpolation=None)
    cp.optionxform = str
    try:
        cp.read_string(paths.engine_conf.read_text())
    except (OSError, configparser.Error):
        return {}
    out: dict = {}
    for s in cp.sections():
        for k, v in cp.items(s):
            out[f"{s}.{k}"] = v
    return out


def conf_bool(v: str) -> bool:
    return str(v).strip().lower() in ("true", "1", "yes", "on")


def validate_conf(paths: Paths, st: dict) -> list[str]:
    """Structural checks on the engine config we wrote (or adopted)."""
    errors = []
    if not paths.engine_conf.is_file():
        return ["engine config missing"]
    flat = read_engine_conf(paths)
    need = ["core.computerName", "core.coreMode", "core.port", "core.preventSleep"]
    for k in need:
        if k not in flat:
            errors.append(f"missing key [{k.split('.')[0]}] {k.split('.')[1]}")
    if st["role"] == "server":
        if not conf_bool(flat.get("server.externalConfig", "false")):
            errors.append("server.externalConfig must be true")
        if not paths.server_map.is_file():
            errors.append(f"screen map missing: {paths.server_map}")
        for k in ("server.enableClipboard", "server.switchDelay"):
            if k not in flat:
                errors.append(f"missing key [{k.split('.')[0]}] {k.split('.')[1]}")
    if st["role"] == "client":
        if not flat.get("client.remoteHost", ""):
            errors.append("client.remoteHost empty")
    _conf_text = paths.engine_conf.read_text()
    if re.search(r"^\s*externalConfigFile\s*=", _conf_text, re.M) and re.search(r"^\[internalConfig\]", _conf_text, re.M):
        errors.append("externalConfigFile and internalConfig cannot both be present")
    sec = flat.get("security.tlsEnabled", "")
    if sec and not conf_bool(sec):
        errors.append("security.tlsEnabled must be true (DeskBridge is TLS-only)")
    return errors


def write_engine_conf(paths: Paths, st: dict) -> list[str]:
    """Write the engine config from state. Returns backup paths created."""
    backups = []
    if paths.engine_conf.is_file():
        bak = paths.engine_conf.with_name(paths.engine_conf.name + f".bak.{int(time.time())}")
        bak.write_text(paths.engine_conf.read_text())
        backups.append(str(bak))
    port = st.get("port") or paths.port
    name = st["name"]
    cp = configparser.ConfigParser(interpolation=None)
    cp.optionxform = str
    cp.add_section("core")
    cp["core"] = {
        "computerName": name,
        "coreMode": "2" if st["role"] == "server" else "1",
        "port": str(port),
        "preventSleep": "false",
    }
    cp.add_section("client")
    cp["client"] = {}
    if st["role"] == "server":
        cp.add_section("server")
        cp["server"] = {
            "externalConfig": "true",
            "externalConfigFile": str(paths.server_map),
            "enableClipboard": "true",
            "switchDelay": "250",
        }
    else:
        cp["client"]["remoteHost"] = st["peer"] or ""
    cp.add_section("security")
    cp["security"] = {
        "tlsEnabled": "true",
        "checkPeerFingerprints": "true",
        "keySize": str(CERT_KEY_SIZE),
    }
    cp.add_section("gui")
    cp["gui"] = {
        "startCoreWithGui": "true",
        "closeToTray": "true",
        "autoHide": "false",
        "enableUpdateCheck": "false",
    }
    cp.add_section("log")
    cp["log"] = {"file": str(paths.log_file), "level": "Info", "toFile": "true"}
    buf = []
    for s in cp.sections():
        buf.append(f"[{s}]")
        for k in cp[s]:
            buf.append(f"{k} = {cp[s][k]}")
        buf.append("")
    paths.engine_home.mkdir(parents=True, exist_ok=True)
    atomic_write(paths.engine_conf, "\n".join(buf), 0o600)
    return backups


def write_server_map(paths: Paths, st: dict) -> None:
    """Synergy-style screen map text for the server role."""
    lines = ["section: links"]
    for computer, neighbors in sorted((st.get("map") or {}).items()):
        lines.append(f"{computer}:")
        for side, other in sorted(neighbors.items()):
            lines.append(f"    {side} = {other}")
    lines.append("end")
    lines.append("section: options")
    lines.append("    clipboardSharing = true")
    lines.append("end")
    lines.append("")
    paths.engine_home.mkdir(parents=True, exist_ok=True)
    atomic_write(paths.server_map, "\n".join(lines), 0o600)


# ---------------------------------------------------------------- engine

def engine_binaries(paths: Paths) -> dict:
    out = {}
    for kind, name in ENGINE_BINARIES.items():
        out[kind] = shutil.which(name)
    return out


def engine_version(probe_binary: str | None) -> str:
    if not probe_binary:
        return "unknown"
    env = dict(os.environ)
    env["QT_QPA_PLATFORM"] = "offscreen"
    try:
        r = run([probe_binary, "--version"], timeout=10, env=env)
    except (OSError, subprocess.TimeoutExpired):
        return "unknown"
    text = (r.stdout + r.stderr).strip()
    m = re.search(r"v(\d+\.\d+\.\d+)", text)
    return m.group(1) if m else (text.splitlines()[0] if text else "unknown")


def engine_ok(paths: Paths, st: dict) -> tuple[bool, str]:
    bins = engine_binaries(paths)
    kind = st.get("engine") or "gui"
    if not bins.get(kind):
        other = "core" if kind == "gui" else "gui"
        if bins.get(other):
            return True, f"engine '{kind}' missing; falling back to '{other}'"
        return False, f"engine binary not found: {ENGINE_BINARIES[kind]}"
    probe = bins.get("core")
    ver = engine_version(probe) if probe else "unknown"
    if ver != "unknown":
        if parse_version(ver) < parse_version(ENGINE_MIN):
            return False, f"engine {ver} < required {ENGINE_MIN}"
    return True, ""


# ---------------------------------------------------------------- supervisor

def find_engine_processes() -> list[dict]:
    procs = []
    try:
        pids = [p for p in os.listdir("/proc") if p.isdigit()]
    except OSError:
        return procs
    for pid in pids:
        try:
            comm = pathlib.Path(f"/proc/{pid}/comm").read_text().strip()
        except OSError:
            continue
        if comm not in LEGACY_PROC_NAMES:
            continue
        try:
            cmdline = pathlib.Path(f"/proc/{pid}/cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace").strip()
        except OSError:
            cmdline = ""
        try:
            environ = pathlib.Path(f"/proc/{pid}/environ").read_bytes()
        except OSError:
            environ = b""
        procs.append({"pid": int(pid), "name": comm, "cmdline": cmdline, "environ": environ})
    return procs


def profile_processes(paths: Paths) -> list[dict]:
    out = []
    for p in find_engine_processes():
        env, cmd = p["environ"], p["cmdline"].encode()
        if paths.profile == "default":
            if b"XDG_CONFIG_HOME=" in env:
                xdg = env.split(b"XDG_CONFIG_HOME=", 1)[1].split(b"\0", 1)[0]
                if b"DeskBridge" in xdg:
                    continue  # belongs to an isolated profile
            out.append(p)
        else:
            if paths.xdg and b"XDG_CONFIG_HOME=" + str(paths.xdg).encode() in env:
                out.append(p)
                continue
            if b"-s " + str(paths.engine_conf).encode() in cmd:
                out.append(p)
    return out


def unit_active(paths: Paths) -> bool:
    if not shutil.which("systemctl"):
        return False
    try:
        r = run(["systemctl", "--user", "is-active", "--quiet", paths.unit], timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return False
    return r.returncode == 0


def unit_main_pid(paths: Paths) -> int | None:
    try:
        r = run(["systemctl", "--user", "show", "--value", "-p", "MainPID", paths.unit], timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    try:
        pid = int(r.stdout.strip())
    except ValueError:
        return None
    return pid or None


def supervisor_env(paths: Paths, st: dict) -> list[str]:
    """systemd-run arguments that isolate this profile from others."""
    args = []
    if paths.xdg:
        paths.xdg.mkdir(parents=True, exist_ok=True)
        args.append(f"--setenv=XDG_CONFIG_HOME={paths.xdg}")
    return args


def start_engine(paths: Paths, st: dict) -> dict:
    kind = st.get("engine") or "gui"
    binary = shutil.which(ENGINE_BINARIES[kind])
    fallback = ""
    if not binary:
        other = "core" if kind == "gui" else "gui"
        binary = shutil.which(ENGINE_BINARIES[other])
        kind, fallback = other, f"engine '{st.get('engine')}' missing; using '{other}'"
    if not binary:
        return {"started": False, "error": f"engine binary not found ({ENGINE_BINARIES[kind] or 'deskflow'})"}
    cmd = [binary]
    if kind == "core" and paths.xdg:
        cmd += ["-s", str(paths.engine_conf)]
    unit_args = [
        "systemd-run", "--user", "--unit", paths.unit, "--collect",
        "--property=Restart=on-failure", "--property=RestartSec=3",
        *supervisor_env(paths, st),
    ] + cmd
    try:
        r = run(unit_args, timeout=15)
    except OSError as e:
        return {"started": False, "error": f"systemd-run failed: {e}"}
    if r.returncode != 0:
        return {"started": False, "error": (r.stderr or r.stdout).strip() or "systemd-run failed"}
    time.sleep(1.0)
    note = [x for x in (fallback,) if x]
    return {"started": True, "unit": paths.unit, "engine": kind, "note": " ".join(note)}


def stop_engine(paths: Paths, timeout: float = 8.0) -> dict:
    killed = []
    had_unit = unit_active(paths)
    if had_unit:
        try:
            run(["systemctl", "--user", "stop", paths.unit], timeout=15)
        except (OSError, subprocess.TimeoutExpired):
            pass
    deadline = time.time() + timeout
    while time.time() < deadline:
        procs = profile_processes(paths)
        if not procs:
            break
        for p in procs:
            try:
                os.kill(p["pid"], 15)
                killed.append(p["pid"])
            except OSError:
                pass
        time.sleep(0.5)
    leftovers = [p["pid"] for p in profile_processes(paths)]
    for pid in leftovers:
        try:
            os.kill(pid, 9)
            killed.append(pid)
        except OSError:
            pass
    if leftovers:
        time.sleep(0.5)
    return {"stopped": True, "unit_was_active": had_unit, "pids_terminated": killed}


# ---------------------------------------------------------------- firewall

def rich_rule(peer: str, port: int) -> str:
    return f'rule family="ipv4" source address="{peer}" port port="{port}" protocol="tcp" accept'


def firewall_state() -> str:
    if not shutil.which("firewall-cmd"):
        return "absent"
    r = run(["firewall-cmd", "--state"], timeout=10)
    return "running" if r.returncode == 0 else "not-running"


def firewall_apply(paths: Paths, peer: str, port: int) -> dict:
    if firewall_state() != "running":
        return {"applied": False, "reason": "firewalld not running (nothing to scope)"}
    rule = rich_rule(peer, port)
    q = run([*sudo_prefix(), "firewall-cmd", f"--query-rich-rule={rule}"], timeout=15)
    if q.returncode == 0:
        return {"applied": True, "changed": False, "rule": rule}
    rt = run([*sudo_prefix(), "firewall-cmd", f"--add-rich-rule={rule}"], timeout=15)
    if rt.returncode != 0:
        return {"applied": False, "reason": (rt.stderr or rt.stdout).strip()}
    pm = run([*sudo_prefix(), "firewall-cmd", "--permanent", f"--add-rich-rule={rule}"], timeout=15)
    if pm.returncode != 0:
        return {"applied": False, "reason": "runtime rule added but permanent failed: " + (pm.stderr or pm.stdout).strip()}
    return {"applied": True, "changed": True, "rule": rule}


def firewall_remove(paths: Paths, peer: str, port: int) -> dict:
    if firewall_state() != "running":
        return {"removed": False, "reason": "firewalld not running"}
    rule = rich_rule(peer, port)
    out = {"removed": False, "changed": False}
    for args in (["--remove-rich-rule"], ["--permanent", "--remove-rich-rule"]):
        r = run([*sudo_prefix(), "firewall-cmd", *args, rule], timeout=15)
        if r.returncode == 0:
            out["changed"] = True
        elif (r.stderr or r.stdout).find("was not found") < 0:
            out["reason"] = (r.stderr or r.stdout).strip()
    out["removed"] = True
    return out


# ---------------------------------------------------------------- tls

def ensure_cert(paths: Paths) -> dict:
    if paths.cert.is_file():
        return {"created": False, "path": str(paths.cert)}
    if not shutil.which("openssl"):
        return {"created": False, "error": "openssl not found"}
    paths.tls_dir.mkdir(parents=True, exist_ok=True)
    os.chmod(paths.tls_dir, 0o700)
    key = paths.cert.with_name("deskflow.key.tmp")
    crt = paths.cert.with_name("deskflow.crt.tmp")
    try:
        r = run([
            "openssl", "req", "-x509", "-newkey", f"rsa:{CERT_KEY_SIZE}", "-nodes",
            "-keyout", str(key), "-out", str(crt), "-days", str(CERT_DAYS),
            "-subj", CERT_SUBJECT,
        ], timeout=60)
        if r.returncode != 0:
            return {"created": False, "error": (r.stderr or r.stdout).strip()}
        pem = key.read_bytes() + crt.read_bytes()
        atomic_write(paths.cert, pem.decode(), 0o600)
        return {"created": True, "path": str(paths.cert)}
    finally:
        for p in (key, crt):
            try:
                p.unlink()
            except OSError:
                pass


def cert_fingerprint(paths: Paths) -> str | None:
    if not paths.cert.is_file():
        return None
    r = run(["openssl", "x509", "-in", str(paths.cert), "-noout", "-fingerprint", "-sha256"], timeout=10)
    if r.returncode != 0:
        return None
    m = re.search(r"=([0-9A-F:]+)", r.stdout)
    return m.group(1).lower().replace(":", "") if m else None


def fingerprint_canon(fp: str) -> str:
    m = FINGERPRINT_RE.match(fp.strip())
    if not m:
        raise ValueError(f"invalid fingerprint (want v2:sha256:<64 hex>): {fp!r}")
    return f"v2:sha256:{m.group(2).lower()}"


def trust_lines(paths: Paths) -> list[str]:
    if not paths.trust_db.is_file():
        return []
    return [ln.strip() for ln in paths.trust_db.read_text().splitlines() if ln.strip()]


def trust_add(paths: Paths, fp: str) -> dict:
    canon = fingerprint_canon(fp)
    lines = trust_lines(paths)
    if canon in lines:
        return {"added": False, "fingerprint": canon}
    lines.append(canon)
    atomic_write(paths.trust_db, "\n".join(lines) + "\n", 0o600)
    return {"added": True, "fingerprint": canon}


def trust_remove(paths: Paths, fp: str) -> dict:
    canon = fingerprint_canon(fp)
    lines = trust_lines(paths)
    if canon not in lines:
        return {"removed": False, "fingerprint": canon}
    lines.remove(canon)
    atomic_write(paths.trust_db, "\n".join(lines) + "\n", 0o600)
    return {"removed": True, "fingerprint": canon}


# ---------------------------------------------------------------- discovery

def tcp_open(ip: str, port: int, timeout: float = 0.35) -> bool:
    try:
        with socket.create_connection((ip, port), timeout=timeout):
            return True
    except OSError:
        return False


def local_networks() -> list[tuple[str, str]]:
    nets = []
    try:
        r = run(["ip", "-4", "-o", "-f", "inet", "addr", "show"], timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return nets
    for line in r.stdout.splitlines():
        parts = line.split()
        if len(parts) >= 5:
            iface, prefix, addr = parts[1], parts[3], parts[4]
            if iface == "lo":
                continue
            nets.append((addr, prefix))
    return nets


def discover(cidr: str | None, port: int, timeout: float = 0.35, workers: int = 64) -> list[dict]:
    """Passive scan: which addresses have the engine port open. No protocol
    traffic is sent, so no pairing prompts are triggered on the peers."""
    import ipaddress
    hosts: list[str] = []
    if cidr:
        for ip in ipaddress.ip_network(cidr, strict=False):
            hosts.append(str(ip))
    else:
        seen = set()
        for addr, prefix in local_networks():
            try:
                net = ipaddress.ip_interface(f"{addr}/{prefix}").network
            except ValueError:
                continue
            for ip in net.hosts():
                s = str(ip)
                if s not in seen:
                    seen.add(s)
                    hosts.append(s)
    found = []
    with ThreadPoolExecutor(max_workers=workers) as pool:
        results = pool.map(lambda h: (h, tcp_open(h, port, timeout)), hosts)
        for h, ok in results:
            if ok:
                found.append({"ip": h, "port": port, "tcp": "open"})
    return found


def deep_probe(ip: str, port: int, cert_path: pathlib.Path, timeout: float = 6.0) -> dict:
    """Full TLS handshake against a candidate engine server using our own
    certificate. Yields the peer certificate fingerprint without the engine
    ever running, so it is safe to use before first connection."""
    if not cert_path.is_file():
        return {"ok": False, "error": f"local certificate missing: {cert_path}"}
    try:
        ctx = ssl.SSLContext(ssl.PROTOCOL_TLS_CLIENT)
        ctx.check_hostname = False
        ctx.verify_mode = ssl.CERT_NONE
        ctx.load_cert_chain(str(cert_path))
        with socket.create_connection((ip, port), timeout=timeout) as sock:
            with ctx.wrap_socket(sock, server_hostname="deskflow") as tls:
                peer = tls.getpeercert(binary_form=True)
                if not peer:
                    return {"ok": False, "error": "peer presented no certificate"}
                cert = ssl.X509Cert()
                cert.load_der_x509_cert(peer)
                der = cert.public_bytes(serialization_format=ssl.Encoding.DER)
                return {
                    "ok": True,
                    "ip": ip,
                    "port": port,
                    "fingerprint": f"v2:sha256:{hashlib.sha256(der).hexdigest()}",
                    "subject": dict(x[0] for x in cert.subject),
                }
    except ssl.SSLError as e:
        return {"ok": False, "error": f"tls handshake failed: {e}"}
    except OSError as e:
        return {"ok": False, "error": f"connection failed: {e}"}


# ---------------------------------------------------------------- layout

def local_layouts() -> list[str]:
    layouts = []
    if shutil.which("gsettings"):
        r = run(["gsettings", "get", "org.gnome.desktop.input-sources", "sources"], timeout=10)
        if r.returncode == 0:
            for m in re.finditer(r"\('(xkb)',\s*'([a-z0-9+-]+)'\)", r.stdout):
                layouts.append(m.group(2))
    if not layouts and shutil.which("localectl"):
        r = run(["localectl", "status"], timeout=10)
        if r.returncode == 0:
            m = re.search(r"Layout:\s*([a-z0-9+-]+)", r.stdout)
            if m:
                layouts.append(m.group(1))
    return sorted(set(layouts))


# ---------------------------------------------------------------- log

def log_tail(paths: Paths, n: int = 6) -> list[str]:
    if not paths.log_file.is_file():
        return []
    try:
        lines = paths.log_file.read_text().splitlines()
    except OSError:
        return []
    out = []
    for ln in lines[-n:]:
        if "PRIVATE KEY" in ln or "BEGIN" in ln and "CERT" in ln:
            continue
        ln = re.sub(r"[0-9a-f]{40,}", lambda m: m.group(0)[:8] + "\u2026(redacted)", ln)
        out.append(ln)
    return out


