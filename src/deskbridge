def collect_status(paths: Paths, st: dict) -> dict:
    port = st.get("port") or paths.port
    procs = profile_processes(paths)
    tcp = []
    if shutil.which("ss"):
        r = run(["ss", "-Htn"], timeout=10)
        for line in r.stdout.splitlines():
            parts = line.split()
            if len(parts) >= 5 and (parts[4].endswith(f":{port}") or parts[3].endswith(f":{port}")):
                if st.get("peer") and st["peer"] not in parts[4]:
                    continue
                tcp.append({"local": parts[3], "peer": parts[4], "state": parts[0]})
    bins = engine_binaries(paths)
    ok, note = engine_ok(paths, st)
    return {
        "profile": paths.profile,
        "role": st.get("role"),
        "name": st.get("name"),
        "peer": st.get("peer"),
        "port": port,
        "engine_kind": st.get("engine") or "gui",
        "engine_installed": bool(bins.get(st.get("engine") or "gui") or bins.get("core")),
        "engine_version": engine_version(bins.get("core")),
        "engine_ok": ok,
        "engine_note": note,
        "config_present": paths.engine_conf.is_file(),
        "config_errors": validate_conf(paths, st) if paths.engine_conf.is_file() else ["engine config missing"],
        "processes": [{"pid": p["pid"], "name": p["name"], "cmdline": p["cmdline"]} for p in procs],
        "unit": {"name": paths.unit, "active": unit_active(paths), "main_pid": unit_main_pid(paths)},
        "tcp": tcp,
        "tls": {
            "cert": str(paths.cert) if paths.cert.is_file() else None,
            "fingerprint": cert_fingerprint(paths),
            "trusted_peers": trust_lines(paths),
        },
        "firewall": {"state": firewall_state(), "peer_rule_recorded": bool(st.get("firewall_scoped")),
                     "scoped": False, "note": "An accept rule alone does not prove other firewall rules restrict access."},
        "autostart": autostart_enabled(paths),
        "log_tail": log_tail(paths),
    }


def adopt_state(paths: Paths, st: dict) -> dict:
    """Fill role/name/peer from an existing engine config when no state exists."""
    if st.get("role") or not paths.engine_conf.is_file():
        return st
    flat = read_engine_conf(paths)
    mode = flat.get("core.coreMode", "")
    if mode not in ("1", "2"):
        return st
    result = dict(st, role="client" if mode == "1" else "server",
                name=st.get("name") or flat.get("core.computerName", ""),
                peer=st.get("peer") or flat.get("client.remoteHost", ""))
    try:
        result["port"] = int(flat.get("core.port", paths.port))
    except ValueError:
        pass
    if mode == "2" and paths.server_map.is_file():
        links, current, in_links = {}, None, False
        for line in paths.server_map.read_text().splitlines():
            line = line.strip()
            if line == "section: links":
                in_links = True
            elif line == "end":
                in_links = False
            elif in_links and line.endswith(":"):
                current = line[:-1]
                links[current] = {}
            elif in_links and current and "=" in line:
                edge, neighbor = (x.strip() for x in line.split("=", 1))
                links[current][{"up": "top", "down": "bottom"}.get(edge, edge)] = neighbor
        result["map"] = links
    return result


def cmd_status(args) -> int:
    paths = Paths(args.profile)
