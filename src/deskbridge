def cmd_serve(args) -> int:
    paths = Paths(args.profile)
    token = secrets.token_urlsafe(16)
    state_ref = {"token": token, "paths": paths}
    lock = threading.RLock()

    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *a):
            pass

        def _token_ok(self) -> bool:
            supplied = self.headers.get("X-DeskBridge-Token", "")
            return self._local_request() and secrets.compare_digest(supplied, state_ref["token"])

        def _local_request(self):
            host = self.headers.get("Host", "")
            expected = f"127.0.0.1:{self.server.server_port}"
            origin = self.headers.get("Origin")
            return host == expected and (origin is None or origin == "http://" + expected)

        def end_headers(self):
            self.send_header("Cache-Control", "no-store")
            self.send_header("Referrer-Policy", "no-referrer")
            self.send_header("X-Content-Type-Options", "nosniff")
            self.send_header("Content-Security-Policy", "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'none'")
            super().end_headers()

        def _json(self, obj, code: int = 200):
            data = json.dumps(obj, indent=2, sort_keys=True).encode()
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def do_GET(self):
            if not self._local_request():
                return self._json({"error": "local requests only"}, 403)
            if self.path.split("?")[0] == "/":
                data = WEB_HTML.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html")
                self.send_header("Content-Length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                return
            elif self.path.split("?")[0] == "/api/status":
                if not self._token_ok():
                    return self._json({"error": "bad token"}, 401)
                with lock:
                    st = adopt_state(state_ref["paths"], load_state(state_ref["paths"]))
                    s = collect_status(state_ref["paths"], st)
                    s["app"] = app_version()
                    s["checks"] = _diagnose_checks(state_ref["paths"], st)
                return self._json(s)
            return self._json({"error": "not found"}, 404)

        def do_POST(self):
            if not self._token_ok():
                return self._json({"error": "bad token"}, 401)
            with lock:
                return self._post_locked()

        def _post_locked(self):
            p = self.path.split("?")[0]
            st = adopt_state(state_ref["paths"], load_state(state_ref["paths"]))
            try:
                if p == "/api/start":
                    res = start_engine(state_ref["paths"], st)
                elif p == "/api/stop":
                    res = stop_engine(state_ref["paths"])
                elif p == "/api/repair":
                    require_configured(state_ref["paths"], st)
                    if profile_processes(state_ref["paths"]):
                        raise ValueError("Stop this profile before repairing configuration")
                    out: dict = {"config": {"rewritten": False}}
                    errs = validate_conf(state_ref["paths"], st)
                    if errs or not state_ref["paths"].engine_conf.is_file():
                        out["config"] = {"rewritten": True, "backups": write_engine_conf(state_ref["paths"], st)}
                        if st.get("role") == "server":
                            write_server_map(state_ref["paths"], st)
                    out["cert"] = ensure_cert(state_ref["paths"])
                    out["config_errors"] = validate_conf(state_ref["paths"], st)
                    res = out
                else:
                    return self._json({"error": "not found"}, 404)
            except SystemExit:
                res = {"error": "command not permitted in this state"}
            except Exception as e:  # noqa: BLE001 - report, don't crash the UI
                res = {"error": str(e)}
            self._json(res)

    port = args.port or WEB_DEFAULT_PORT
    httpd = ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = f"http://127.0.0.1:{port}/?t={token}"
    print(f"{APP} web ui on {url}", file=sys.stderr)
    print("(token is in this URL; bound to 127.0.0.1 only; Ctrl-C to stop)", file=sys.stderr)
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        httpd.server_close()
    return 0


# ---------------------------------------------------------------- main

def main(argv: list[str] | None = None) -> int:
    p = argparse.ArgumentParser(
        prog="deskbridge",
        description="Guided keyboard/mouse/clipboard sharing over Deskflow "
                    "(thin product layer; the Deskflow engine does the work).",
    )
    p.add_argument("--profile", default="default",
                   help="profile name (default: 'default'; more profiles isolate config/state/engine per LAN/peer)")
    p.add_argument("--json", action="store_true", help="machine-readable output")
    sub = p.add_subparsers(dest="cmd")

    def add(name, fn, help_, setup_extra: bool = False):
        sp = sub.add_parser(name, help=help_, description=help_)
        sp.set_defaults(fn=fn)
        if setup_extra:
            sp.add_argument("--role", choices=("server", "client"))
            sp.add_argument("--peer", help="peer address (server IP for a client)")
            sp.add_argument("--name", help="computer name for this machine")
            sp.add_argument("--peer-name", help="client computer name for the server layout")
            sp.add_argument("--trust-fingerprint", help="complete peer SHA256 fingerprint compared on the other PC; never inferred from the network")
            sp.add_argument("--quiet-layouts", action="store_true", help="remember suppression of missing-layout popups; does not install or fix layouts")
            sp.add_argument("--side", choices=tuple(SIDES), help="screen edge (server role only)")
            sp.add_argument("--port", type=int)
            sp.add_argument("--engine", choices=("gui", "core"))
            sp.add_argument("--autostart", choices=("on", "off"),
                            help="start at login (default: ask; re-runs keep the current setting)")
            sp.add_argument("--start-now", action="store_true", help="start the engine when the wizard ends")
            sp.add_argument("--yes", action="store_true", help="accept all defaults, no prompts")
        return sp

    add("version", cmd_version, "show DeskBridge and engine versions")
    add("setup", cmd_setup, "guided setup wizard (role, peer, screen placement, TLS, firewall)", setup_extra=True)
    add("start", cmd_start, "start the engine for this profile")
    add("stop", cmd_stop, "stop the engine for this profile")
    add("restart", cmd_restart, "stop then start")
    add("status", cmd_status, "show profile state, engine, processes, tcp, tls, firewall, log tail")
    add("diagnose", cmd_diagnose, "run all checks with suggested fixes")
    add("repair", cmd_repair, "rewrite engine config from state, regenerate cert, re-scope firewall")
    add("fingerprint", cmd_fingerprint, "show this machine's TLS fingerprint (compare at the other machine)")
    sp = add("trust", cmd_trust, "list/add/remove trusted peer fingerprints")
    sp.add_argument("trust_cmd", choices=("list", "add", "remove"), nargs="?", default="list")
    sp.add_argument("fingerprint", nargs="?", help="fingerprint (v2:sha256:<64 hex> or bare hex)")
    sp = add("discover", cmd_discover, "find engines on the LAN (passive) or fetch a server fingerprint (--deep)")
    sp.add_argument("--peer", help="address to probe (required with --deep)")
    sp.add_argument("--deep", action="store_true", help="TLS handshake to fetch the peer certificate fingerprint")
    sp.add_argument("--cidr", help="scan this network instead of local networks")
    sp.add_argument("--port", type=int)
    add("layout", cmd_layout, "show local input layouts (install the same on the other machine)")
    sp = add("autostart", cmd_autostart, "explicitly opt in or out of desktop-login startup")
    sp.add_argument("mode", choices=("on", "off", "status"), default="status", nargs="?")
    sp = add("serve", cmd_serve, "local web UI (127.0.0.1, token-protected)")
    sp.add_argument("--port", type=int, help=f"listen port (default {WEB_DEFAULT_PORT})")
    sp = add("uninstall", cmd_uninstall, "stop, remove product state and scoped firewall rule; keep the engine")

    args = p.parse_args(argv)
    if not getattr(args, "cmd", None):
        p.print_help()
        return 0
    if args.cmd == "trust" and args.trust_cmd in ("add", "remove") and not args.fingerprint:
        p.error("trust add/remove needs a fingerprint")
    try:
        return args.fn(args)
    except (ValueError, OSError, subprocess.TimeoutExpired) as e:
        if args.json:
            print(json.dumps({"error": str(e)}))
        else:
            print(f"{APP}: {e}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
